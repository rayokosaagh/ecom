# Copy to .env and fill in. This file IS committed; .env is not.

# --- Database ---------------------------------------------------------------
# A real local PostgreSQL, not `prisma dev`.
#
#   winget install PostgreSQL.PostgreSQL.17
#   createdb -U postgres ecom          (or: psql -U postgres -c "CREATE DATABASE ecom")
#   npm run db:push && npm run db:seed
#
# It runs as the `postgresql-x64-17` Windows service, so it is already up at
# boot and nothing needs starting alongside `npm run dev`. `npm run db` now just
# reports whether it is reachable.
#
# This replaced a `prisma dev` (PGlite) instance on port 51214. That server
# dropped pooled connections often enough to surface as P1017 "Server has closed
# the connection" mid-render, and grew an unread write-ahead log at ~1 MB/min
# with no flag to turn it off. The retry and pool-recycling in `lib/prisma.ts`
# exist because of it and are worth keeping — they are cheap, and they cover a
# genuinely dropped connection on any server.
DATABASE_URL="postgres://postgres:CHANGE-ME@localhost:5432/ecom"

# Only `prisma migrate` reads this, and this project uses `db push`. Postgres
# creates and drops the shadow database per run, so it need not exist yet.
SHADOW_DATABASE_URL="postgres://postgres:CHANGE-ME@localhost:5432/ecom_shadow"

# --- Auth.js ----------------------------------------------------------------
# Required. Generate with:  npx auth secret
# or:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Optional. "false" disables the /register route.
ALLOW_PUBLIC_SIGNUP="true"

# --- Outbound links & email -------------------------------------------------
# The origin used to build links that leave the browser — currently the
# password-reset link. Deliberately configured rather than read from the
# request's Host header, which an attacker controls: a poisoned Host would send
# a real customer a genuine-looking mail pointing at someone else's server.
# Required in production; defaults to http://localhost:3000 in development.
APP_URL="http://localhost:3000"

# Leave both blank in development and reset emails are written to the server
# console instead of being sent — the whole flow, including clicking the link,
# works with no mail provider at all. Set both to deliver for real.
# The key is a Resend API key (https://resend.com); EMAIL_FROM must be an
# address on a domain verified with them, e.g. "Ecom <no-reply@yourshop.com>".
RESEND_API_KEY=""
EMAIL_FROM=""

# --- WhatsApp -----------------------------------------------------------------
# The shop's WhatsApp number, for the "ask us" buttons on product, order and FAQ
# pages. Click-to-chat only — no API key and no cost; the link opens the app on
# a phone and WhatsApp Web on a desktop.
#
# Must be in full international form. Punctuation is stripped, so
# "+44 7911 123456", "+447911123456" and "00447911123456" are all fine — but a
# national number with no country code ("07911 123456") cannot be detected as
# wrong and will produce a link that fails.
#
# Leave blank and the buttons render nothing at all, which is the intended state
# for a shop with no number.
WHATSAPP_NUMBER=""

# --- Seed -------------------------------------------------------------------
# Credentials for the first administrator created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Store Admin"

# --- Currency ---------------------------------------------------------------
# Which currency the shop prices in: NPR or USD. Defaults to NPR when unset.
#
# This is a *display* setting, and it must agree with the currency the database
# is actually denominated in — every money column stores minor units of the
# shop currency, not of some base currency converted at render.
#
# Changing it is therefore two steps, and the order matters:
#
#   npm run currency -- --from NPR --to USD --rate 0.00704 --dry-run
#   npm run currency -- --from NPR --to USD --rate 0.00704
#   then set this to USD and restart
#
# The script records the new currency on StoreSettings and refuses to run twice,
# so a repeat cannot silently multiply every price again. Prose that quotes an
# amount (the delivery FAQ, promo banner subtext) is not converted and has to be
# edited by hand.
NEXT_PUBLIC_SHOP_CURRENCY="NPR"
