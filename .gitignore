# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Secrets — never commit these.
# ---------------------------------------------------------------------------
# Real environment files, including .env.local / .env.production.
.env
.env.*
# ...but the documented template must stay tracked.
!.env.example

# Auth.js writes AUTH_SECRET here when you run `npx auth secret`.
.auth

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
# Service-account credentials
**/*service-account*.json
**/*credentials*.json
gha-creds-*.json

# Database dumps and local database files
*.sql
*.sqlite
*.sqlite3
*.db
/prisma-dev-backup*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Generated code — recreated by `prisma generate` (runs on postinstall).
# ---------------------------------------------------------------------------
/src/generated/

# Uploaded product images — user content, not source. Keep the directory so a
# fresh clone has somewhere to write.
/public/uploads/*
!/public/uploads/.gitkeep
